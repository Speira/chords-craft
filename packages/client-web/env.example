# fill a new .env.local file with:
# _________________ NEVER ADD SECRET HERE !!! ____________________ #
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# The AppSync GraphQL endpoint (stack output GraphQLApiUrl).
# src/lib/graphql throws "No graphql endpoint defined" without it.
NEXT_PUBLIC_GRAPHQL_URL=https://xxxxx.appsync-api.eu-west-3.amazonaws.com/graphql
# _________________ NEVER ADD SECRET HERE !!! ____________________ #
