{
  "name": "@chordcraft/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:watch": "tsc -b tsconfig.build.json --watch",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:run",
    "ci": "pnpm clean && pnpm install --frozen-lockfile && pnpm build",
    "clean": "node scripts/clean.ts",
    "codegen": "pnpm -r --parallel --if-present run codegen",
    "coverage": "vitest run --coverage --project '!integration'",
    "dev": "pnpm --parallel --filter \"./packages/{api,client}-*\" run dev",
    "dev:web": "pnpm --filter @chordcraft/client-web dev",
    "format": "prettier --write . && pnpm lint:fix",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "pnpm lint --fix",
    "prepare": "lefthook install",
    "test": "vitest --project '!integration'",
    "test:integration": "vitest run --project integration",
    "test:run": "vitest run --project '!integration'",
    "typecheck": "pnpm -r --parallel --if-present run typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.0",
    "@effect/build-utils": "^0.7.7",
    "@effect/language-service": "latest",
    "@effect/schema": "^0.75.5",
    "@effect/vitest": "latest",
    "@eslint-react/eslint-plugin": "^5.20.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "effect": "^3.19.12",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "glob": "^11.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pretty-format": "^30.2.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  }
}
